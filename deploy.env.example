# Copy to /opt/play-his1/.env on the VPS (chmod 600). CI never ships this file; agents never edit it. Fill every value yourself.
# secret = never shown, never in the repo. Plain KEY=value lines, no quotes, no spaces around "=".

# --- Required (deploy.sh refuses to run without them) ---
# secret: the facilitator PIN for /host (6 or more characters).
HOST_PIN=
# secret: signs the host session cookie (32 or more characters). Generate with:  openssl rand -hex 32
SESSION_SECRET=
# The public origin. Every POST must carry this exact Origin.
PUBLIC_ORIGIN=https://play-his1.endura-assess.com

# --- Platform (defaults shown; change only if you know why) ---
# Private bind only: 172.17.0.1 (proxy in a container, Nginx Proxy Manager) or 127.0.0.1. Never 0.0.0.0.
HOST_BIND_IP=172.17.0.1
HOST_APP_PORT=8098
# PLAY_DATA_DIR=/opt/play-his1/data
